# Copy to .env and fill in. Never commit .env.

# The model the agent uses, and that provider's key.
INCIDENT_AGENT_MODEL=openai:gpt-5-mini
OPENAI_API_KEY=your-openai-api-key
# For Anthropic instead:
# INCIDENT_AGENT_MODEL=anthropic:claude-sonnet-4-5
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Shared secret the alerting side signs webhooks with (HMAC-SHA256). Make it long and random:
#   python -c "import secrets; print(secrets.token_hex(32))"
ALERT_WEBHOOK_SECRET=replace-with-a-long-random-string
ALERT_WEBHOOK_PORT=9095

# Optional: sign the ops server's audit log as an HMAC chain.
# PROMPTISE_AUDIT_SECRET=replace-with-another-long-random-string
