# Copy to .env and fill in. Never commit .env.

# The model the agent uses, and that provider's key. Any Promptise model string works.
INCIDENT_AGENT_MODEL=openai:gpt-5-mini
OPENAI_API_KEY=your-openai-api-key
# INCIDENT_AGENT_MODEL=anthropic:claude-sonnet-4-5
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Shared secret the alerting side signs webhooks with (HMAC-SHA256). Make it long and random:
#   python -c "import secrets; print(secrets.token_hex(32))"
ALERT_WEBHOOK_SECRET=replace-with-a-long-random-string
ALERT_WEBHOOK_PORT=9095

# Optional: your own ops MCP server. Unset, the agent starts the local stand-in with fresh keys.
# OPS_MCP_URL=https://ops-mcp.internal/mcp
# OPS_AGENT_API_KEY=replace-with-the-agent-key-of-that-server

# Optional: the Alertmanager relay (scripts/alertmanager_relay.py).
# ALERTMANAGER_TOKEN=replace-with-the-bearer-token-alertmanager-sends

# Optional: sign the ops server's audit log as an HMAC chain.
# PROMPTISE_AUDIT_SECRET=replace-with-another-long-random-string
