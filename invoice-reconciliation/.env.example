# Copy to .env and fill in. `promptise run` loads it; it never overrides variables already set.

# The model and its key. Any provider string Promptise supports works, for example
# anthropic:claude-sonnet-4-5 with ANTHROPIC_API_KEY.
FINANCE_AGENT_MODEL=openai:gpt-5-mini
OPENAI_API_KEY=

# The signing secret of your Stripe webhook endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=
WEBHOOK_PORT=8787

# Optional: send refunds above 100 EUR to your approval service instead of this terminal.
APPROVAL_WEBHOOK_URL=
APPROVAL_WEBHOOK_SECRET=

# Optional: serve the runtime control API on 127.0.0.1:9100 (resume after a budget pause).
# Use a long random value, for example: openssl rand -hex 32
RUNTIME_API_TOKEN=
