# Copy to .env and fill in. `promptise run` loads it; it never overrides variables already set.

# The model and its key. Any provider string Promptise supports works, for example
# anthropic:claude-sonnet-4-5 with ANTHROPIC_API_KEY.
FINANCE_AGENT_MODEL=openai:gpt-5-mini
OPENAI_API_KEY=
# Reasoning effort for OpenAI reasoning models (low, medium, high). Low is plenty here.
FINANCE_AGENT_REASONING=low

# The signing secret of your Stripe webhook endpoint (whsec_...).
# For local tries, any long random value: openssl rand -hex 32
STRIPE_WEBHOOK_SECRET=
WEBHOOK_PORT=8787

# The key that signs the billing and email servers' audit logs. Keep it: without it
# nobody can verify the logs later. Generate one: openssl rand -hex 32
PROMPTISE_AUDIT_SECRET=

# Optional: the API key the agent presents to the billing and email servers.
# Unset, a new random key is made at every start.
FINANCE_AGENT_API_KEY=

# Optional: a cron expression to override 04:30 Europe/Berlin, for example "*/5 * * * *".
FINANCE_CRON=

# Optional: send refunds above 100 EUR to your approval service instead of this terminal.
APPROVAL_WEBHOOK_URL=
APPROVAL_WEBHOOK_SECRET=

# Optional: serve the runtime control API on 127.0.0.1:9100 (resume after a budget pause).
# Use a long random value: openssl rand -hex 32
RUNTIME_API_TOKEN=
