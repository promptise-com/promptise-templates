# Real-model mode. Not needed for `promptise run demo` / `python main.py --offline`.
OPENAI_API_KEY=your-openai-api-key
# Any provider string Promptise accepts, e.g. anthropic:claude-sonnet-4-5 (then set ANTHROPIC_API_KEY).
SUPPORT_MODEL=openai:gpt-5-mini

# Only when the backend runs as its own service (python -m support_desk.backend):
# the secret your login service signs user tokens with, and the backend's URL.
# SUPPORT_JWT_SECRET=a-long-random-secret
# SUPPORT_BACKEND_URL=http://127.0.0.1:8765/mcp
