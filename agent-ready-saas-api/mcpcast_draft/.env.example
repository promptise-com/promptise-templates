# Environment for the taskboard MCP server. Copy to .env (git-ignored) and fill in.
# The generated code only reads these; credentials are never written into the project.
#
# Who reads .env: `python server.py` (the file beside server.py, wherever the
# client started it from), `python -m taskboard_mcp` and `taskboard-mcp` (the working
# directory or a parent), `promptise serve` and `promptise mcpcast --serve` (the
# working directory) and `docker run --env-file .env`. A variable already set in
# the environment wins; PROMPTISE_NO_DOTENV=1 skips the file. The generated
# tests never read it.

# Point the same server at another environment without regenerating. When set,
# it also replaces the host of operations that declare their own server. One
# clean URL: no query string, fragment or user:password@ (refused at start-up).
# MCPCAST_BASE_URL=http://127.0.0.1:8000

# api-key: MCP clients present x-api-key; each key names a tenant (JSON object).
# Read once at start-up — rotating client keys needs a restart. Mint each key:
#     python -c 'import secrets; print("sk-" + secrets.token_urlsafe(32))'
# then fill in the shape below. build_server() refuses to start with no key,
# with a <placeholder> key or with a key from the documentation (sk-acme,
# sk-reviewer): those are public.
#   MCPCAST_CLIENT_KEYS={"sk-<generated>": {"client_id": "acme-agent", "tenant_id": "acme", "roles": []}}
MCPCAST_CLIENT_KEYS=
# Each tenant's upstream credential (JSON object: tenant -> Authorization header value).
# Read on every call — rotate without a restart.
MCPCAST_UPSTREAM_TOKENS={"acme": "Bearer <your API token>"}
# Approval mode 'pending': gated calls that may wait for a reviewer at once —
# in the whole server, per tenant, per client key. Beyond a cap the call is
# denied immediately, so one tenant (or one of its keys) cannot fill the store
# and get everyone else's calls denied.
MCPCAST_MAX_PENDING=100
MCPCAST_MAX_PENDING_PER_TENANT=40
MCPCAST_MAX_PENDING_PER_CLIENT=20

# Total time one upstream call may take, in seconds (connecting, sending, waiting
# and reading the body together); past it the tool returns UPSTREAM_TIMEOUT.
MCPCAST_TIMEOUT=30
# How long a gated call waits for a human decision before it is denied.
MCPCAST_APPROVAL_TIMEOUT=300
# Largest upstream response body passed on to the agent, in bytes.
MCPCAST_MAX_RESPONSE_BYTES=1048576
# How many characters of an upstream error body the agent may see (0 hides it).
# The credential is scrubbed from the body first, whatever the number.
MCPCAST_ERROR_EXCERPT_CHARS=500
# Send the upstream credential to a plain-http host that is not loopback.
# MCPCAST_ALLOW_INSECURE_HTTP=1
