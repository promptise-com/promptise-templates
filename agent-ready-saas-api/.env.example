# Copy to .env, or run `promptise run setup` to write one with fresh values.
# Every value below is a placeholder.

# --- the Taskboard REST API ---------------------------------------------------
# One API token per customer workspace (JSON: workspace id -> token).
TASKBOARD_API_TOKENS={"acme": "<acme-api-token>", "globex": "<globex-api-token>"}

# --- the MCP server -----------------------------------------------------------
TASKBOARD_API_URL=http://127.0.0.1:8000
# The tokens the MCP server presents to the API, per workspace. Same shape as above.
TASKBOARD_UPSTREAM_TOKENS={"acme": "<acme-api-token>", "globex": "<globex-api-token>"}
# Key for the HMAC chain of the audit log. Keep it: you need it to verify the log.
PROMPTISE_AUDIT_SECRET=<a-long-random-string>
TASKBOARD_KEYS_FILE=.data/agent_keys.json
TASKBOARD_AUDIT_LOG=.data/audit.jsonl
TASKBOARD_APPROVAL_TIMEOUT=300
TASKBOARD_RATE_LIMIT_PER_MINUTE=60
TASKBOARD_RATE_LIMIT_BURST=20
TASKBOARD_MCP_HOST=127.0.0.1
TASKBOARD_MCP_PORT=8080

# --- the customer's agent -----------------------------------------------------
TASKBOARD_MCP_URL=http://127.0.0.1:8080/mcp
# Mint with: promptise run keys create --workspace acme --name acme-ops-agent --access admin
TASKBOARD_AGENT_KEY=<tbk_agent-key>
# A key with the approver role, for `promptise run approvals`.
TASKBOARD_APPROVER_KEY=<tbk_reviewer-key>
TASKBOARD_AGENT_MODEL=openai:gpt-5-mini
OPENAI_API_KEY=<your-openai-key>
